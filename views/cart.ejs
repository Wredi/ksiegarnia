<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Koszyk</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="css/pages/cart.css">
</head>
<body>
    <div class="page">
        <%- include('partials/navigation', { user: user }) %>

        <div class="main-container">
            <div class="loading-overlay" style="display: none;"><p>Loading...</p></div>

            <% if (typeof paymentMessage !== 'undefined') { %>
                <div class="alert alert-success" role="alert">
                    <%= paymentMessage %>
                </div>
            <% } %>

            <div class="cart-container">
                <div class="cart-items">
                    <% cart.books.forEach(book => { %>
                    <div class="cart-item">
                        <div class="book-info">
                            <img src="<%= '/images/' + book.image_path%>" alt="Book Cover" class="book-image" />
                            <div class="book-details">
                                <p><%= book.title %></p>
                                <p class="authors"><%= book.authors %></p>
                                <p class="authors">Stan: <%= book.state %></p>
                            </div>
                        </div>
                        <div class="book-price">
                            <p><%= book.price %> zł</p>
                        </div>
                        <div class="quantity-control">
                            <button 
                                class="decrement quantity-control-button" 
                                data-book-id="<%= book.option_id %>"
                                <%= book.quantity <= 1 ? 'disabled' : '' %>
                            >-</button>
                            <input 
                                type="number" 
                                class="quantity-input" 
                                value="<%= book.quantity %>" 
                                data-book-id="<%= book.option_id %>" 
                                data-available-quantity="<%= book.available_quantity %>"
                            />
                            <button 
                                class="increment quantity-control-button" 
                                data-book-id="<%= book.option_id %>"
                                <%= book.quantity >= book.available_quantity ? 'disabled' : '' %>
                            >+</button>
                        </div>
                        <div class="total-price">
                            <p><%= book.total_price %> zł</p>
                        </div>
                        <button class="delete-button" data-book-id="<%= book.option_id %>"><span class="material-symbols-outlined">close</span></button>
                    </div>
                    <% }) %>
                </div>
                <div class="cart-summary">
                    <div class="summary-details">
                        <p>Cena: <%= cart.sum %> zł</p>
                        <p>Rabat: <%= cart.discount_sum %> zł (<%= cart.discount_percent %>%)</p>
                        <p>SUMA: <%= cart.total %> zł</p>
                    </div>
                    <form action="/cart" method="POST">
                        <button type="submit" class="checkout-button">Przejdź do płatności</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="/scripts/cart.js"></script>
</body>
</html>

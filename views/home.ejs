<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
        .material-symbols-outlined {
          font-variation-settings:
          'FILL' 0,
          'wght' 400,
          'GRAD' 0,
          'opsz' 24
        }
    </style>
    <link rel="stylesheet" href="/css/pages/home.css">
</head>
<body>
    <div class="page">
        <%- include('partials/navigation', { user: user }) %>

        <section class="welcome-banner">
            <div class="welcome-text">
                <h1>Witamy w naszej księgarni!</h1>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque eget purus vitae ante iaculis elementum eget at felis. Nam tristique a sapien vel euismod. Donec non enim condimentum, dapibus arcu a, fermentum dolor.</p>
                <a href="/browse" class="btn">Odkryj naszą kolekcję</a>
            </div>
        </section>

         <section class="latest-books">
            <h2>Ostatnie Pozycje</h2>
            <div class="book-container">
                <% recentBooks.forEach(book => { %>
                <a class="book-card-link" href="/book/<%= book.id %>">
                    <div class="book-card">
                            <img src="<%= "/images/" + book.image_path %>" alt="<%= book.title %>" class="book-image">
                            <p class="book-title"><%= book.title %></p>
                            <p class="book-author"><%= book.authors %></p>
                            <p class="book-price"><%= book.min_price %> zł</p>
                    </div>
                </a>
                <% }) %>
            </div>
        </section>
    </div>
</body>
</html>
